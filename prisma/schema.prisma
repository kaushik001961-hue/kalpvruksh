generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(USER)
  createdAt DateTime   @default(now())
  volunteer Volunteer?
}

model Volunteer {
  id                 String          @id @default(cuid())
  phone              String
  city               String
  message            String?
  createdAt          DateTime        @default(now())
  userId             String?         @unique
  address            String?
  availability       String?
  country            String          @default("India")
  education          String?
  email              String          @unique
  emergencyName      String?
  emergencyPhone     String?
  firstName          String
  gender             String?
  languages          String?
  lastName           String
  occupation         String?
  organization       String?
  pincode            String?
  skills             String?
  state              String?
  updatedAt          DateTime        @updatedAt
  dob                DateTime?
  interest           String
  status             VolunteerStatus @default(PENDING)
  photo              String?
  resume             String?
  aadhaarFile        String?
  aadhaarNumber      String?
  allergies          String?
  alternatePhone     String?
  approvedAt         DateTime?
  approvedBy         String?
  bloodGroup         String?
  college            String?
  course             String?
  designation        String?
  district           String?
  drivingLicense     String?
  emergencyRelation  String?
  experienceYears    Int?
  facebook           String?
  idCardNumber       String?
  instagram          String?
  joinedDate         DateTime?
  linkedin           String?
  maritalStatus      String?
  medicalConditions  String?
  medications        String?
  middleName         String?
  nationality        String          @default("Indian")
  panFile            String?
  panNumber          String?
  passingYear        Int?
  passportNumber     String?
  policeVerification String?
  preferredLocation  String?
  previousExperience String?
  remarks            String?
  volunteerCode      String?         @unique
  voterId            String?
  whatsappNumber     String?
  user               User?           @relation(fields: [userId], references: [id])
}

model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  image     String?
  content   String
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id          String        @id @default(cuid())
  title       String
  image       String?
  description String
  status      ProjectStatus @default(PLANNED)
  location    String?
  createdAt   DateTime      @default(now())
  stats       String?
}

model Gallery {
  id        String   @id @default(cuid())
  image     String
  caption   String?
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  image       String?
  description String
  date        DateTime
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String  @id @default(cuid())
  organization String
  email        String
  phone        String
  address      String
  facebook     String?
  instagram    String?
  youtube      String?
}

model Donation {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String?
  amount    Float
  status    DonationStatus @default(PENDING)
  createdAt DateTime       @default(now())
}

enum Role {
  ADMIN
  REPORTER
  EDITOR
  USER
  VOLUNTEER
  SUPER_ADMIN
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}
