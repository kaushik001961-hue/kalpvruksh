generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(USER)
  createdAt DateTime   @default(now())
  volunteer Volunteer?
}
model Volunteer {
  id                  String   @id @default(cuid())

  // User Account
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id])

  // Personal Information
  firstName           String
  middleName          String?
  lastName            String
  gender              String?
  dob                 DateTime?
  bloodGroup          String?
  maritalStatus       String?
  nationality         String   @default("Indian")

  // Contact
  phone               String
  alternatePhone      String?
  whatsappNumber      String?
  email               String   @unique

  // Address
  address             String?
  city                String
  district            String?
  state               String?
  country             String   @default("India")
  pincode             String?

  // Identity
  aadhaarNumber       String?
  panNumber           String?
  voterId             String?
  drivingLicense      String?
  passportNumber      String?

  // Education
  education           String?
  college             String?
  course              String?
  passingYear         Int?

  // Employment
  occupation          String?
  organization        String?
  designation         String?
  experienceYears     Int?

  // Volunteer Information
  interest            String
  skills              String?
  languages           String?
  availability        String?
  preferredLocation   String?
  previousExperience  String?
  message             String?

  // Emergency Contact
  emergencyName       String?
  emergencyRelation   String?
  emergencyPhone      String?

  // Medical
  allergies           String?
  medicalConditions   String?
  medications         String?

  // Documents
  photo               String?
  resume              String?
  aadhaarFile         String?
  panFile             String?
  policeVerification  String?

  // Social
  facebook            String?
  instagram           String?
  linkedin            String?

  // Office Use
  volunteerCode       String?  @unique
  idCardNumber        String?
  joinedDate          DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  remarks             String?

  // Status
  status              VolunteerStatus @default(PENDING)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  image     String?
  content   String
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id          String        @id @default(cuid())
  title       String
  image       String?
  description String
  status      ProjectStatus @default(PLANNED)
  location    String?
  createdAt   DateTime      @default(now())
  stats       String?
}

model Gallery {
  id        String   @id @default(cuid())
  image     String
  caption   String?
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  image       String?
  description String
  date        DateTime
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String  @id @default(cuid())
  organization String
  email        String
  phone        String
  address      String
  facebook     String?
  instagram    String?
  youtube      String?
}

model Donation {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String?
  amount    Float
  status    DonationStatus @default(PENDING)
  createdAt DateTime       @default(now())
}

model VolunteerSkill {
  id          String @id @default(cuid())
  volunteerId String
  skill       String

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}

model VolunteerDocument {
  id          String @id @default(cuid())
  volunteerId String
  type        String
  fileUrl     String

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}

model VolunteerActivity {
  id           String @id @default(cuid())
  volunteerId  String
  activityName String
  activityDate DateTime
  hours        Int?
  remarks      String?

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}

model VolunteerAttendance {
  id           String @id @default(cuid())
  volunteerId  String
  checkIn      DateTime
  checkOut     DateTime?
  eventName    String?

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  REPORTER
  EDITOR
  USER
  VOLUNTEER
  SUPER_ADMIN
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}
